# Kalibra Adaptive Engine: copy to .env (cp .env.example .env).
#
# ============================================================================
# REQUIRED: the only two values you have to fill in.
# Without them the engine still boots and mastery estimation works; generation
# and extraction answer 502 and GET /health/ready reports the missing key.
# ============================================================================

# DeepSeek: exercise generation (V4-Flash) and verification fallback (V4-Pro).
DEEPSEEK_API_KEY=

# Mistral: OCR for curricular extraction.
MISTRAL_API_KEY=

# ============================================================================
# OPTIONAL: every value below is the built-in default. Change only what you need.
# ============================================================================

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Mistral OCR
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Outbound HTTP: read timeout of one provider call and attempts on transient failures
# (transport errors, 408, 429 and 5xx).
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=3

# Generation loop: attempts per exercise before the run is exhausted, and runs
# processed at the same time per request.
GENERATION_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=4

# Bayesian Knowledge Tracing defaults: P(L0), P(T), P(G), P(S).
BKT_INITIAL_MASTERY=0.30
BKT_LEARNING=0.10
BKT_GUESS=0.25
BKT_SLIP=0.10
# Partial overrides per subtopic, as JSON keyed by subtopic UUID (default: none).
# BKT_SUBTOPIC_OVERRIDES={"8f14e45f-ceea-467a-9575-000000000002": {"learning": 0.15, "slip": 0.05}}
BKT_SUBTOPIC_OVERRIDES={}

# Redis task queue (Streams).
# REDIS_ENABLED is left unset on purpose: a bare run (uv run fastapi dev ...) defaults to
# false, and docker compose defaults to true because its stack includes Redis. Uncomment
# to force either one.
# REDIS_ENABLED=false
# docker compose always points the engine at its own Redis, whatever this says.
REDIS_URL=redis://localhost:6379/0
REDIS_TASKS_STREAM=kalibra:engine:tasks
REDIS_RESULTS_STREAM=kalibra:engine:results
REDIS_CONSUMER_GROUP=adaptive-engine
# Unique per process; defaults to <hostname>-<pid>. Set it only to pin a name.
# REDIS_CONSUMER_NAME=adaptive-engine-1
REDIS_WORKER_CONCURRENCY=4
REDIS_BLOCK_MILLISECONDS=5000
REDIS_CLAIM_IDLE_MILLISECONDS=900000
REDIS_MAX_DELIVERIES=3
REDIS_RESULTS_MAX_LENGTH=100000

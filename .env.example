# Kalibra Adaptive Engine — copy to .env and fill in the provider keys.

# DeepSeek (generation: V4-Flash · verification fallback: V4-Pro)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Mistral OCR (curricular extraction)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Outbound HTTP
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=3

# Generation loop
GENERATION_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=4

# Bayesian Knowledge Tracing defaults
BKT_INITIAL_MASTERY=0.30
BKT_LEARNING=0.10
BKT_GUESS=0.25
BKT_SLIP=0.10

# Redis task queue (Streams). Off until kalibra-api publishes tasks.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_TASKS_STREAM=kalibra:engine:tasks
REDIS_RESULTS_STREAM=kalibra:engine:results
REDIS_CONSUMER_GROUP=adaptive-engine
REDIS_WORKER_CONCURRENCY=4
REDIS_CLAIM_IDLE_MILLISECONDS=900000
REDIS_MAX_DELIVERIES=3
